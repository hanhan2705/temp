# Sao chép file này thành .env và điền giá trị thực
# cp .env.example .env

# PostgreSQL
DB_PASSWORD=your_strong_password_here

# JWT Secret Key (tối thiểu 32 ký tự, ngẫu nhiên)
JWT_KEY=your_random_jwt_secret_at_least_32_chars_here

# CORS - Frontend URL (phân cách bằng dấu phẩy nếu nhiều origin)
ALLOWED_ORIGINS=http://localhost:5173
